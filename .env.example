# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SHARED_APP_URL: Public shared preview URL for trusted CSRF origin validation.
SHARED_APP_URL="MY_SHARED_APP_URL"

# SESSION_SECRET: Mandatory in production (NODE_ENV=production).
# Must be at least 32 characters of high-entropy random text loaded from Secret Manager.
SESSION_SECRET="REPLACE_WITH_64_CHAR_HIGH_ENTROPY_SECRET_FROM_SECRET_MANAGER"

# ALLOWED_ORIGINS: Optional comma-separated list of trusted HTTPS origins for CSRF verification.
ALLOWED_ORIGINS=""
