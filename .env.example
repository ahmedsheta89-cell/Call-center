# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SHARED_APP_URL: Public shared preview URL for trusted CSRF origin validation.
SHARED_APP_URL="MY_SHARED_APP_URL"

# SESSION_SECRET: Mandatory in production (NODE_ENV=production).
# Must be at least 32 characters of high-entropy random text loaded from Secret Manager.
SESSION_SECRET="REPLACE_WITH_64_CHAR_HIGH_ENTROPY_SECRET_FROM_SECRET_MANAGER"

# CHANNEL_SECRET_ENCRYPTION_KEY: Required for AES-256-GCM authenticated encryption-at-rest of channel secrets.
# Must be an exact 64-character lowercase hexadecimal string (32 bytes = 256 bits) matching ^[0-9a-f]{64}$.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHANNEL_SECRET_ENCRYPTION_KEY="REPLACE_WITH_64_LOWERCASE_HEX_CHARS_32_BYTES_AES_256_GCM_KEY"

# ALLOWED_ORIGINS: Optional comma-separated list of trusted HTTPS origins for CSRF verification.
ALLOWED_ORIGINS=""
