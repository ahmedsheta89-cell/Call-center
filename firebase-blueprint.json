{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and agent authentication credentials",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["agent", "supervisor", "admin", "executive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "Omnichannel support and service desk ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "assignedAgent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Omnichannel customer communication thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channel": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "status": { "type": "string" },
        "lastMessage": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "channel", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID"
    },
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Operational support tickets"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Unified communications threads"
    }
  }
}
